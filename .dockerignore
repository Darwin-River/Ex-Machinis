# Keep the Docker build context small and free of local secrets.
.git
.github
node_modules
vendor
.env
.env.*
!.env.example
deploy/.env
deploy/mail/config
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
game-engine/src/objs
game-engine/src/bin
game-engine/src/embed/*.o
game-engine/src/embed/*.a
game-engine/src/embed/*.blk
game-engine/src/embed/embed
# The website shows the players' manual (Getting Started) and the blog
# (#589: leaving the posts out emptied the live blog and its RSS feed)
documents/*
!documents/players-manual.md
!documents/images
!documents/blog
