APP_NAME=Ex-Machinis
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=exmachinis
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# No email: there are no accounts, and drones' replies show on the website
# (#367 step 5)
MAIL_DRIVER=log

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=

CRON_KEY=
# Behind a reverse proxy that terminates HTTPS: the proxy IPs, or * for any.
#TRUSTED_PROXIES=
REPORTS_DESTINATION=example@example.com


